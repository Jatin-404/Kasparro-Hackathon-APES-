ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TEMPERATURE=0.0
OLLAMA_MAX_TOKENS=1600
OLLAMA_TIMEOUT=180
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_DELAY=2.0
OLLAMA_NUM_CTX=8192
OLLAMA_GENERATE_PERSONAS=false
OLLAMA_VERIFY_FAILURES=false
OLLAMA_FORENSICS=false
OLLAMA_GENERATE_FIXES=false
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
APES_DEMO_LOCK=true

# PostgreSQL persistence. Leave disabled for no-DB demos; enable when using docker-compose.
APES_ENABLE_DB=true
APES_DB_REQUIRED=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/apes_db
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# docker-compose postgres + pgAdmin defaults
POSTGRES_DB=apes_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433
PGADMIN_DEFAULT_PASSWORD=postgres


